# PostgreSQL connection string.
# Read by backend/src/config/db.ts. The pool is created with ssl: { rejectUnauthorized: true },
# so this must point to a Postgres instance that accepts SSL with a valid certificate.
DATABASE_URL=postgresql://user:password@localhost:5432/chordflow

# Port the Express server listens on. Read by backend/src/index.ts. Defaults to 4000 if unset.
PORT=4000

# Secret used to sign and verify JWTs (jwt.sign / jwt.verify).
# Read by backend/src/services/auth.service.ts and backend/src/middlewares/auth.middleware.ts.
JWT_SECRET=change-me-to-a-long-random-string

# Exact origin allowed by CORS. Must match the browser Origin header character for character
# (no trailing slash). Read by backend/src/index.ts, which falls back to FRONTEND_ORIGIN and
# then CORS_ORIGIN if this one is empty.
FRONTEND_URL=http://localhost:5173
